# Server-side only. Never prefix these with VITE_ — anything prefixed VITE_ is
# bundled into the client and readable in view-source.
#
# Set in Cloudflare Pages -> Settings -> Environment variables.
# If either is unset, /api/reviews answers { ok: false } and the site falls
# back to the reviews committed in src/reviews.js. That is a safe default.

# Google Cloud console -> APIs & Services -> Credentials.
# Restrict the key to the Places API (New) and nothing else.
GOOGLE_PLACES_API_KEY=

# NOT the CID from a Maps share link. A Place ID looks like ChIJ....
# Find it with Google's Place ID Finder:
# https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=

# CLIENT-SIDE, and therefore PUBLIC once the page is served.
# This must be a DIFFERENT key from GOOGLE_PLACES_API_KEY above:
#   - restricted to the Maps Embed API and nothing else
#   - restricted by HTTP referrer to dubshackmotorsport.co.uk
# Reusing the server-side Places key here would publish it, and anyone viewing
# source could then run Places calls billed to the client.
#
# Without it the map falls back to a geocoded pin on Edensor Road with no
# business card. Tested: the keyless form cannot resolve a Place ID.
VITE_GOOGLE_MAPS_EMBED_KEY=

# --- The enquiry form ------------------------------------------------------
# Server-side. The Brevo key must never be prefixed VITE_.
BREVO_API_KEY=
# The workshop. Comma separate to add more, e.g. a second mobile's inbox.
ENQUIRY_TO_EMAIL=dubshackmotorsport@gmail.com

# Copied openly, so the client sees who else got it. Usually empty.
ENQUIRY_CC_EMAIL=

# Copied silently. The studio's monitoring address, matching Exley and Bee
# Smart. It is how you find out the form has stopped working before the client
# does, and how you spot a lead the workshop has not replied to.
#
# NOTE THIS IS PERSONAL DATA. A blind copy means the studio RECEIVES AND KEEPS
# the customer's name, number and email, which is more than merely relaying it.
# The privacy notice says so explicitly. If you ever remove this, say so there
# too.
ENQUIRY_BCC_EMAIL=seo@alex-stanley.co.uk
# The sender domain MUST be authenticated in the sending Brevo account
# (SPF + DKIM) or the mail bounces. studioalex.co.uk already is, which is why
# it is used here rather than dubshackmotorsport.co.uk: it works on day one
# with no DNS work on the client's domain.
#
# This is only the envelope sender. replyTo is set to the customer, so hitting
# reply in the workshop's inbox goes to them, not to the studio.
#
# A gmail.com address will never work as a sender.
ENQUIRY_FROM_EMAIL=emails@studioalex.co.uk

# Turnstile. The secret is server-side. The site key is public by design and
# lives in .env.production, committed, alongside the Maps embed key.
#
# ONE KEYPAIR SERVES EVERY STUDIO ALEX SITE. A Turnstile widget accepts a list
# of hostnames, so the same pair covers classictocurrenttransmissions.co.uk,
# beesmartspraying.co.uk, exley-transport.co.uk and this one. Add the new
# hostname to the existing widget rather than creating a keypair per site.
#
# UNSET, THIS FORM STILL WORKS. It falls back to the honeypot alone and warns
# in the function logs, matching Classic to Current and Bee Smart. Exley fails
# closed and is the odd one out of the four.
TURNSTILE_SECRET_KEY=
